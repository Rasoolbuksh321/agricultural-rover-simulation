<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="wave_rover">

    <pose>0 0 0 0 0 0</pose>
    <static>false</static>

    <!-- ====================================================== -->
    <!-- BASE / CHASSIS                                         -->
    <!-- ====================================================== -->

    <link name="base_link">

      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>0 0 0.65 0 0 0</pose>
        <mass>25.0</mass>

        <inertia>
          <ixx>4.0</ixx>
          <iyy>4.0</iyy>
          <izz>4.0</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>


      <!-- BASE COLLISION -->

      <collision name="base_collision">

        <pose>0 0 0.78 0 0 0</pose>

        <geometry>
          <box>
            <size>1.55 1.15 0.35</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>

      </collision>


      <!-- CHASSIS STL -->

      <visual name="chassis_visual">

        <pose>0 0 0 1.5708 0 1.5708</pose>

        <geometry>
          <mesh>

            <uri>
              file:///home/rasoolbuksh/rover_ws/src/rover_description/meshes/chassis.stl
            </uri>

            <scale>0.001 0.001 0.001</scale>

          </mesh>
        </geometry>

      </visual>


      <!-- ====================================================== -->
      <!-- LIDAR STL VISUAL                                       -->
      <!-- ====================================================== -->

      <visual name="lidar_visual">

        <pose>0 0 0 1.5708 0 1.5708</pose>

        <geometry>
          <mesh>

            <uri>
              file:///home/rasoolbuksh/rover_ws/src/rover_description/meshes/lidar_sensor.stl
            </uri>

            <scale>0.001 0.001 0.001</scale>

          </mesh>
        </geometry>

      </visual>


      <!-- ====================================================== -->
      <!-- ACTUAL GAZEBO 2D LIDAR SENSOR                          -->
      <!-- ====================================================== -->

      <sensor name="front_lidar" type="gpu_lidar">

        <!-- Position of laser scanner relative to base_link -->
        <pose>0 0 1.20 0 0 0</pose>

        <!-- Gazebo LiDAR topic -->
        <topic>/scan</topic>

        <!-- 10 scans per second -->
        <update_rate>10</update_rate>


        <ray>

          <!-- 360 degree horizontal scan -->

          <scan>

            <horizontal>

              <samples>720</samples>

              <resolution>1</resolution>

              <min_angle>-3.14159</min_angle>

              <max_angle>3.14159</max_angle>

            </horizontal>

          </scan>


          <!-- Detection distance -->

          <range>

            <min>0.15</min>

            <max>12.0</max>

            <resolution>0.01</resolution>

          </range>


          <!-- Small realistic measurement noise -->

          <noise>

            <type>gaussian</type>

            <mean>0.0</mean>

            <stddev>0.01</stddev>

          </noise>

        </ray>


        <always_on>true</always_on>

        <!-- Show laser rays in Gazebo -->
        <visualize>true</visualize>

      </sensor>

    </link>


    <!-- ====================================================== -->
    <!-- FRONT LEFT WHEEL                                       -->
    <!-- ====================================================== -->

    <link name="front_left_wheel">

      <pose>0.57 0.665 0.46 1.5708 0 0</pose>

      <inertial>

        <mass>2.5</mass>

        <inertia>

          <ixx>0.25</ixx>
          <iyy>0.25</iyy>
          <izz>0.25</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>

        </inertia>

      </inertial>


      <collision name="collision">

        <geometry>

          <cylinder>

            <radius>0.46</radius>

            <length>0.545</length>

          </cylinder>

        </geometry>


        <surface>

          <friction>

            <ode>

              <mu>6.0</mu>
              <mu2>5.0</mu2>

              <slip1>0.0</slip1>
              <slip2>0.0</slip2>

            </ode>

          </friction>


          <contact>

            <ode>

              <kp>1000000</kp>

              <kd>100</kd>

              <max_vel>0.05</max_vel>

              <min_depth>0.001</min_depth>

            </ode>

          </contact>

        </surface>

      </collision>


      <visual name="visual">

        <geometry>

          <cylinder>

            <radius>0.46</radius>

            <length>0.545</length>

          </cylinder>

        </geometry>


        <material>

          <ambient>0.02 0.02 0.02 1</ambient>

          <diffuse>0.02 0.02 0.02 1</diffuse>

        </material>

      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- FRONT RIGHT WHEEL                                      -->
    <!-- ====================================================== -->

    <link name="front_right_wheel">

      <pose>0.57 -0.665 0.46 1.5708 0 0</pose>


      <inertial>

        <mass>2.5</mass>

        <inertia>

          <ixx>0.25</ixx>
          <iyy>0.25</iyy>
          <izz>0.25</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>

        </inertia>

      </inertial>


      <collision name="collision">

        <geometry>

          <cylinder>

            <radius>0.46</radius>

            <length>0.545</length>

          </cylinder>

        </geometry>


        <surface>

          <friction>

            <ode>

              <mu>6.0</mu>
              <mu2>5.0</mu2>

              <slip1>0.0</slip1>
              <slip2>0.0</slip2>

            </ode>

          </friction>


          <contact>

            <ode>

              <kp>1000000</kp>

              <kd>100</kd>

              <max_vel>0.05</max_vel>

              <min_depth>0.001</min_depth>

            </ode>

          </contact>

        </surface>

      </collision>


      <visual name="visual">

        <geometry>

          <cylinder>

            <radius>0.46</radius>

            <length>0.545</length>

          </cylinder>

        </geometry>


        <material>

          <ambient>0.02 0.02 0.02 1</ambient>

          <diffuse>0.02 0.02 0.02 1</diffuse>

        </material>

      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- REAR LEFT WHEEL                                        -->
    <!-- ====================================================== -->

    <link name="rear_left_wheel">

      <pose>-0.57 0.665 0.46 1.5708 0 0</pose>


      <inertial>

        <mass>2.5</mass>

        <inertia>

          <ixx>0.25</ixx>
          <iyy>0.25</iyy>
          <izz>0.25</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>

        </inertia>

      </inertial>


      <collision name="collision">

        <geometry>

          <cylinder>

            <radius>0.46</radius>

            <length>0.545</length>

          </cylinder>

        </geometry>


        <surface>

          <friction>

            <ode>

              <mu>6.0</mu>
              <mu2>5.0</mu2>

              <slip1>0.0</slip1>
              <slip2>0.0</slip2>

            </ode>

          </friction>


          <contact>

            <ode>

              <kp>1000000</kp>

              <kd>100</kd>

              <max_vel>0.05</max_vel>

              <min_depth>0.001</min_depth>

            </ode>

          </contact>

        </surface>

      </collision>


      <visual name="visual">

        <geometry>

          <cylinder>

            <radius>0.46</radius>

            <length>0.545</length>

          </cylinder>

        </geometry>


        <material>

          <ambient>0.02 0.02 0.02 1</ambient>

          <diffuse>0.02 0.02 0.02 1</diffuse>

        </material>

      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- REAR RIGHT WHEEL                                       -->
    <!-- ====================================================== -->

    <link name="rear_right_wheel">

      <pose>-0.57 -0.665 0.46 1.5708 0 0</pose>


      <inertial>

        <mass>2.5</mass>

        <inertia>

          <ixx>0.25</ixx>
          <iyy>0.25</iyy>
          <izz>0.25</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>

        </inertia>

      </inertial>


      <collision name="collision">

        <geometry>

          <cylinder>

            <radius>0.46</radius>

            <length>0.545</length>

          </cylinder>

        </geometry>


        <surface>

          <friction>

            <ode>

              <mu>6.0</mu>
              <mu2>5.0</mu2>

              <slip1>0.0</slip1>
              <slip2>0.0</slip2>

            </ode>

          </friction>


          <contact>

            <ode>

              <kp>1000000</kp>

              <kd>100</kd>

              <max_vel>0.05</max_vel>

              <min_depth>0.001</min_depth>

            </ode>

          </contact>

        </surface>

      </collision>


      <visual name="visual">

        <geometry>

          <cylinder>

            <radius>0.46</radius>

            <length>0.545</length>

          </cylinder>

        </geometry>


        <material>

          <ambient>0.02 0.02 0.02 1</ambient>

          <diffuse>0.02 0.02 0.02 1</diffuse>

        </material>

      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- WHEEL JOINTS                                           -->
    <!-- ====================================================== -->


    <!-- FRONT LEFT -->

    <joint name="front_left_wheel_joint" type="revolute">

      <parent>base_link</parent>

      <child>front_left_wheel</child>

      <axis>

        <xyz>0 0 -1</xyz>

        <limit>

          <lower>-1e16</lower>

          <upper>1e16</upper>

        </limit>

        <dynamics>

          <damping>0.3</damping>

          <friction>0.15</friction>

        </dynamics>

      </axis>

    </joint>


    <!-- FRONT RIGHT -->

    <joint name="front_right_wheel_joint" type="revolute">

      <parent>base_link</parent>

      <child>front_right_wheel</child>

      <axis>

        <xyz>0 0 -1</xyz>

        <limit>

          <lower>-1e16</lower>

          <upper>1e16</upper>

        </limit>

        <dynamics>

          <damping>0.3</damping>

          <friction>0.15</friction>

        </dynamics>

      </axis>

    </joint>


    <!-- REAR LEFT -->

    <joint name="rear_left_wheel_joint" type="revolute">

      <parent>base_link</parent>

      <child>rear_left_wheel</child>

      <axis>

        <xyz>0 0 -1</xyz>

        <limit>

          <lower>-1e16</lower>

          <upper>1e16</upper>

        </limit>

        <dynamics>

          <damping>0.3</damping>

          <friction>0.15</friction>

        </dynamics>

      </axis>

    </joint>


    <!-- REAR RIGHT -->

    <joint name="rear_right_wheel_joint" type="revolute">

      <parent>base_link</parent>

      <child>rear_right_wheel</child>

      <axis>

        <xyz>0 0 -1</xyz>

        <limit>

          <lower>-1e16</lower>

          <upper>1e16</upper>

        </limit>

        <dynamics>

          <damping>0.3</damping>

          <friction>0.15</friction>

        </dynamics>

      </axis>

    </joint>


    <!-- ====================================================== -->
    <!-- JOINT STATE PUBLISHER                                  -->
    <!-- ====================================================== -->

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher"/>


    <!-- ====================================================== -->
    <!-- DIFFERENTIAL DRIVE CONTROLLER                          -->
    <!-- ====================================================== -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>1.33</wheel_separation>

      <wheel_radius>0.46</wheel_radius>

      <odom_publish_frequency>50</odom_publish_frequency>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>

      <frame_id>odom</frame_id>

      <child_frame_id>base_link</child_frame_id>

    </plugin>


  </model>

</sdf>
