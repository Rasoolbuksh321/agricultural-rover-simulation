<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="agri_world">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- REQUIRED FOR LIDAR / CAMERA / OTHER SENSORS -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun light -->
    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.2</intensity>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <!-- Main soil ground -->
    <model name="soil_ground">
      <static>true</static>
      <link name="soil_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 22 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 22 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.38 0.25 0.13 1</ambient>
            <diffuse>0.48 0.31 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Slight darker soil patches -->
    <model name="dark_soil_patch_1">
      <static>true</static>
      <pose>-5 -6 0.035 0 0 0.2</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>5 2.5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.16 0.08 1</ambient>
            <diffuse>0.32 0.20 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="dark_soil_patch_2">
      <static>true</static>
      <pose>6 5 0.036 0 0 -0.35</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>6 3 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.28 0.18 0.09 1</ambient>
            <diffuse>0.36 0.23 0.11 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crop rows with wider spacing for rover -->
    <model name="crop_row_1">
      <static>true</static>
      <pose>0 -6 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24 0.28 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 0.28 0.7</size></box></geometry>
          <material>
            <ambient>0.04 0.35 0.04 1</ambient>
            <diffuse>0.05 0.60 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crop_row_2">
      <static>true</static>
      <pose>0 -3 0.42 0 0 0.015</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24 0.32 0.85</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 0.32 0.85</size></box></geometry>
          <material>
            <ambient>0.03 0.33 0.04 1</ambient>
            <diffuse>0.04 0.58 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crop_row_3">
      <static>true</static>
      <pose>0 0 0.36 0 0 -0.01</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24 0.25 0.72</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 0.25 0.72</size></box></geometry>
          <material>
            <ambient>0.04 0.38 0.04 1</ambient>
            <diffuse>0.05 0.65 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crop_row_4">
      <static>true</static>
      <pose>0 3 0.40 0 0 0.02</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24 0.30 0.80</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 0.30 0.80</size></box></geometry>
          <material>
            <ambient>0.04 0.36 0.04 1</ambient>
            <diffuse>0.06 0.62 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crop_row_5">
      <static>true</static>
      <pose>0 6 0.34 0 0 -0.02</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24 0.27 0.68</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 0.27 0.68</size></box></geometry>
          <material>
            <ambient>0.04 0.34 0.04 1</ambient>
            <diffuse>0.05 0.58 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small rocks / obstacles -->
    <model name="rock_obstacle_1">
      <static>true</static>
      <pose>5 1.4 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.6 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.6 0.45</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.20 1</ambient>
            <diffuse>0.35 0.34 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_obstacle_2">
      <static>true</static>
      <pose>-6 -1.5 0.18 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.55 0.45 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.55 0.45 0.35</size></box></geometry>
          <material>
            <ambient>0.20 0.20 0.19 1</ambient>
            <diffuse>0.32 0.32 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple tree 1 -->
    <model name="tree_1">
      <static>true</static>
      <pose>-10 8 0 0 0 0</pose>
      <link name="trunk">
        <visual name="trunk_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.28 0.14 0.05 1</ambient>
            <diffuse>0.36 0.18 0.07 1</diffuse>
          </material>
        </visual>
        <visual name="leaf_visual">
          <pose>0 0 1.75 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.75</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.02 0.30 0.04 1</ambient>
            <diffuse>0.04 0.50 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple tree 2 -->
    <model name="tree_2">
      <static>true</static>
      <pose>11 -8 0 0 0 0</pose>
      <link name="trunk">
        <visual name="trunk_visual">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.28 0.14 0.05 1</ambient>
            <diffuse>0.36 0.18 0.07 1</diffuse>
          </material>
        </visual>
        <visual name="leaf_visual">
          <pose>0 0 1.55 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.65</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.02 0.28 0.04 1</ambient>
            <diffuse>0.04 0.46 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Field boundary wooden posts -->
    <model name="wood_post_1">
      <static>true</static>
      <pose>-12 -9 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.45 0.23 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wood_post_2">
      <static>true</static>
      <pose>-6 -9 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.45 0.23 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wood_post_3">
      <static>true</static>
      <pose>0 -9 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.45 0.23 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wood_post_4">
      <static>true</static>
      <pose>6 -9 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.45 0.23 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wood_post_5">
      <static>true</static>
      <pose>12 -9 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.45 0.23 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
